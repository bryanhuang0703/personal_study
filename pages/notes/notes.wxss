/* 移植自 CS50 AI 小程序包（数据存档于 source/cs50-ai/ai.js）：主题变量（只作用于本页）+ 原页面样式 */
page {
  --bg: #F2F4F6;
  --surface: #FFFFFF;
  --fg: #14202B;
  --muted: #566676;
  --line: #D3DBE2;
  --accent: #A51C30;
  --on-accent: #FFFFFF;
  --duck: #F2C230;
  --ok: #1E6B4A;
  --ok-bg: #E1F1E8;
  --code-bg: #E9EDF1;
  --mono: Menlo, "SF Mono", Consolas, "Courier New", monospace;

  background: var(--bg);
  color: var(--fg);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 32rpx;
  line-height: 1.7;
}

@media (prefers-color-scheme: dark) {
  page {
    --bg: #0F161C;
    --surface: #17212A;
    --fg: #E4EAEF;
    --muted: #93A3B1;
    --line: #2A3743;
    --accent: #E8697B;
    --on-accent: #0F161C;
    --duck: #E5B83A;
    --ok: #7ADBAE;
    --ok-bg: #17352A;
    --code-bg: #0B1116;
  }
}

/* 单列布局，按手机竖屏阅读设计。尺寸换算：1px = 2rpx（375 宽设计稿）。 */
.page {
  padding: 32rpx 32rpx calc(96rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

text {
  display: block;
}

.mono {
  font-family: var(--mono);
}

.muted {
  color: var(--muted);
}

.small {
  font-size: 26rpx;
}

.tap {
  opacity: 0.7;
}

/* 头部 */
.top {
  margin-bottom: 56rpx;
}

.kicker-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.dot {
  width: 20rpx;
  height: 20rpx;
  margin-right: 16rpx;
  background: var(--duck);
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
}

.kicker {
  font-family: var(--mono);
  font-size: 24rpx;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  color: var(--muted);
}

.h1 {
  font-size: 60rpx;
  line-height: 1.25;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.lede {
  font-size: 30rpx;
  color: var(--muted);
}

.h2 {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}

.block {
  margin-bottom: 56rpx;
}

/* 框架速览 */
.chain {
  background: var(--surface);
  border: 2rpx solid var(--line);
  border-radius: 20rpx;
  padding: 12rpx 32rpx;
}

.chain-item {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.chain-n {
  width: 64rpx;
  flex: none;
  font-family: var(--mono);
  font-size: 26rpx;
  color: var(--accent);
  padding-top: 4rpx;
}

.chain-body {
  flex: 1;
  min-width: 0;
}

.chain-t {
  font-weight: 700;
  font-size: 30rpx;
}

.chain-d {
  color: var(--muted);
  font-size: 28rpx;
  line-height: 1.6;
}

.chain-gap {
  padding: 16rpx 0 16rpx 64rpx;
  font-size: 26rpx;
  color: var(--muted);
  border-bottom: 2rpx dashed var(--line);
}

.chain-gap-label {
  display: inline;
  color: var(--fg);
  font-weight: 500;
  margin-right: 12rpx;
}

.chain-gap-text {
  display: inline;
}

.chain > view:last-child {
  border-bottom: 0;
}

/* 进度与筛选 */
.progress-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  font-size: 28rpx;
  margin-bottom: 12rpx;
}

.progress-row .mono {
  font-size: 26rpx;
}

.bar {
  height: 12rpx;
  background: var(--line);
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.fill {
  height: 100%;
  background: var(--ok);
  transition: width 0.25s ease;
}

.seg {
  display: flex;
  margin-bottom: 20rpx;
}

.seg-btn,
.jump-item {
  min-height: 80rpx;
  padding: 0 28rpx;
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  background: var(--surface);
  color: var(--fg);
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.seg-btn {
  margin-right: 16rpx;
}

.seg-btn.on {
  background: var(--accent);
  border-color: var(--accent);
  color: var(--on-accent);
}

.jump {
  white-space: nowrap;
  width: 100%;
}

.jump-item {
  display: inline-flex;
  margin-right: 16rpx;
}

.jump-key {
  display: inline;
  font-family: var(--mono);
  font-size: 26rpx;
  color: var(--accent);
  margin-right: 12rpx;
}

/* 章节 */
.sec {
  margin-bottom: 56rpx;
}

.sec-h {
  display: flex;
  align-items: baseline;
  padding-bottom: 16rpx;
  border-bottom: 4rpx solid var(--fg);
}

.sec-key {
  font-family: var(--mono);
  font-size: 28rpx;
  color: var(--accent);
  margin-right: 20rpx;
}

.sec-t {
  font-size: 40rpx;
  font-weight: 700;
}

.sec-note {
  font-size: 28rpx;
  color: var(--muted);
  margin-top: 16rpx;
}

/* 卡片 */
.card {
  background: var(--surface);
  border: 2rpx solid var(--line);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-top: 24rpx;
}

.card-head {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}

.idx {
  font-family: var(--mono);
  font-size: 26rpx;
  color: var(--muted);
  margin-right: 20rpx;
}

.card.done .idx {
  color: var(--ok);
}

.en {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.4;
  margin-right: 16rpx;
}

.zh {
  font-size: 28rpx;
  color: var(--muted);
}

.def {
  font-size: 32rpx;
  line-height: 1.75;
  margin-bottom: 20rpx;
}

.row {
  display: flex;
  font-size: 30rpx;
  line-height: 1.7;
  margin-bottom: 20rpx;
}

.row-t {
  flex: 1;
  min-width: 0;
}

.tag {
  width: 96rpx;
  flex: none;
  font-family: var(--mono);
  font-size: 22rpx;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  color: var(--muted);
  padding-top: 6rpx;
}

.tag.acc {
  color: var(--accent);
}

.code-wrap {
  width: 100%;
  box-sizing: border-box;
  background: var(--code-bg);
  border-radius: 12rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  white-space: nowrap;
}

.code {
  display: inline-block;
  font-family: var(--mono);
  font-size: 26rpx;
  line-height: 1.6;
  white-space: pre;
}

/* 自测 */
.test {
  border-top: 2rpx dashed var(--line);
  padding-top: 24rpx;
}

.test-sum {
  display: flex;
  align-items: flex-start;
  font-size: 30rpx;
  line-height: 1.7;
}

.q {
  flex: 1;
  min-width: 0;
}

.tg {
  flex: none;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--muted);
  padding-top: 6rpx;
}

.ans {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  background: var(--ok-bg);
  border-radius: 12rpx;
  font-size: 30rpx;
  line-height: 1.7;
}

.card-foot {
  display: flex;
  justify-content: flex-end;
  margin-top: 24rpx;
}

.mark {
  min-height: 80rpx;
  padding: 0 32rpx;
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.mark.on {
  background: var(--ok-bg);
  border-color: var(--ok);
  color: var(--ok);
  font-weight: 500;
}

.empty {
  text-align: center;
  color: var(--muted);
  padding: 48rpx 0;
}

/* 资料 */
.res-item {
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.res-label {
  font-size: 30rpx;
  font-weight: 500;
}

.res-url {
  font-size: 26rpx;
  color: var(--accent);
  word-break: break-all;
}

.reset {
  margin-top: 32rpx;
  display: inline-flex;
  min-height: 80rpx;
  padding: 0 28rpx;
  align-items: center;
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--muted);
  box-sizing: border-box;
}
