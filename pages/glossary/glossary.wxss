.page { padding-bottom: calc(76px + env(safe-area-inset-bottom)); }

/* 吸顶头部 */
.head {
  position: sticky; top: 0; z-index: 5;
  background: var(--panel); border-bottom: 1px solid var(--line);
  padding: 10px 0 8px;
}
.search {
  display: flex; align-items: center; gap: 8px;
  margin: 0 16px; padding: 0 12px; height: 38px;
  background: var(--bg); border: 1px solid var(--line); border-radius: 8px;
}
.sinput { flex: 1; font-size: 15px; color: var(--ink); }
.sclear { color: var(--muted); font-size: 13px; padding: 4px; }
.chaps { white-space: nowrap; margin-top: 8px; padding: 0 16px; box-sizing: border-box; }
.chap {
  display: inline-flex; align-items: center; gap: 6px; margin-right: 6px;
  padding: 5px 12px; border: 1px solid var(--line); border-radius: 999px; font-size: 14px;
}
.chap .ct { font-size: 11px; color: var(--muted); font-family: "SF Mono", Menlo, monospace; }
.chap.on { background: var(--ink); border-color: var(--ink); color: var(--panel); }
.chap.on .ct { color: inherit; opacity: .7; }
.prog { display: flex; align-items: center; gap: 10px; margin: 8px 16px 0; font-size: 12px; color: var(--muted); }
.prog .bar { flex: 1; }
.reset { text-decoration: underline; }

.body { padding: 12px 16px 0; }
.toolbar { white-space: nowrap; margin: 0 -16px 12px; padding: 0 16px; box-sizing: border-box; width: auto; }
.toolbar .chip { margin-right: 8px; }
.cnt { display: inline-block; font-size: 13px; color: var(--muted); margin-left: 4px; vertical-align: middle; }

/* 浏览 */
.sechead { display: flex; align-items: baseline; gap: 10px; margin: 18px 0 8px; }
.sechead:first-of-type { margin-top: 0; }
.sechead .no { font-size: 12px; color: var(--accent); font-family: "SF Mono", Menlo, monospace; }
.sechead .h2 { font-size: 18px; font-weight: 600; }
.sechead .sen { font-size: 12px; color: var(--muted); }
.list { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; overflow: hidden; }
.row { position: relative; padding: 12px 14px; border-top: 1px solid var(--line); }
.row:first-child { border-top: 0; }
.r1 { display: flex; align-items: flex-start; gap: 12px; }
.zh { flex: 1; font-size: 17px; font-weight: 700; }
.en { font-size: 15px; font-weight: 500; color: var(--steel); margin-top: 2px; }
.note { font-size: 14px; color: var(--muted); margin-top: 4px; }
.code { position: absolute; right: 14px; bottom: 8px; font-size: 10px; color: var(--line); font-family: "SF Mono", Menlo, monospace; }
.abbr { margin-left: 8px; font-size: 12px; font-weight: 500; color: var(--muted); font-family: "SF Mono", Menlo, monospace; }
.mask .abbr { color: transparent; }
.note-en { font-size: 13px; color: var(--muted); opacity: .85; margin-top: 2px; }
.why { margin-top: 8px; padding-left: 10px; border-left: 3px solid var(--accent); font-size: 14px; }
.why-lab { font-size: 11px; color: var(--accent); font-weight: 600; letter-spacing: .04em; }
.why-en { font-size: 13px; color: var(--muted); margin-top: 2px; }
.mw { display: inline-block; border-radius: 4px; transition: all .15s; }
.mask { background: var(--line); color: transparent; }
.mask .hl { background: none; color: transparent; }
.hl { background: var(--accent-soft); border-radius: 2px; }
.ib {
  flex: none; width: 34px; height: 34px; display: flex; align-items: center; justify-content: center;
  border: 1px solid var(--line); border-radius: 6px; color: var(--muted); font-size: 15px; font-weight: 700;
}
.ib.known { background: var(--good-soft); border-color: var(--good); color: var(--good); }

/* 闪卡 */
.fc-meta { display: flex; justify-content: space-between; font-size: 13px; color: var(--muted); margin-bottom: 8px; }
.card { height: 46vh; max-height: 340px; perspective: 1400px; }
.card.tall { height: 58vh; max-height: 460px; }
.face.back { overflow-y: auto; }
.fbody { margin: auto 0; display: flex; flex-direction: column; align-items: center; gap: 10px; padding-top: 12px; }
.desc-en { font-size: 13px; opacity: .85; }
.inner { position: relative; height: 100%; transition: transform .5s cubic-bezier(.2,.7,.2,1); transform-style: preserve-3d; -webkit-transform-style: preserve-3d; }
.card.flip .inner { transform: rotateY(180deg); }
.face {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0; box-sizing: border-box;
  background: var(--panel); border: 1px solid var(--line); border-radius: 14px;
  padding: 22px 20px; display: flex; flex-direction: column; justify-content: center; align-items: center;
  text-align: center; gap: 10px;
  backface-visibility: hidden; -webkit-backface-visibility: hidden;
  box-shadow: 0 10px 30px -18px rgba(20,32,43,.35);
  border-left: 6px solid var(--accent);
}
.face.back { transform: rotateY(180deg); border-left-color: var(--steel); }
.face .tag { position: absolute; top: 14px; left: 18px; font-size: 12px; color: var(--muted); font-family: "SF Mono", Menlo, monospace; }
.face .hint { position: absolute; bottom: 12px; font-size: 12px; color: var(--muted); }
.big { font-size: 32px; font-weight: 700; line-height: 1.2; }
.big.en { color: var(--steel); font-size: 25px; }
.sub { font-size: 17px; font-weight: 500; }
.desc { font-size: 14px; color: var(--muted); }
.fc-ctrl { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
.fc-ctrl .btn { flex: 1 1 26%; }
.fc-ctrl .again, .fc-ctrl .ok { flex: 1 1 40%; padding: 14px 6px; font-size: 16px; }
.spk { width: 16px; height: 16px; margin-right: 4px; }
.ib .spk { margin-right: 0; }
.r1 .ib + .ib { margin-left: -6px; }

/* 自测 */
.qz-score { display: flex; gap: 8px; margin-bottom: 12px; }
.stat { flex: 1; background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 8px 12px; }
.sv { display: block; font-size: 20px; font-weight: 600; font-variant-numeric: tabular-nums; }
.sl { font-size: 12px; color: var(--muted); }
.qbox { background: var(--panel); border: 1px solid var(--line); border-radius: 14px; padding: 18px 16px; }
.q-tag { font-size: 12px; color: var(--muted); font-family: "SF Mono", Menlo, monospace; }
.q { font-size: 26px; font-weight: 700; line-height: 1.25; margin: 8px 0 4px; }
.q.en { color: var(--steel); font-size: 22px; }
.q.def { font-size: 17px; font-weight: 500; line-height: 1.55; }
.q-prompt { font-size: 13px; color: var(--accent); margin-top: 8px; }
.opt-t { flex: 1; min-width: 0; }
.opt-sub { font-size: 12px; color: var(--muted); }
.q-note { color: var(--muted); font-size: 14px; }
.opts { margin-top: 16px; }
.opt {
  display: flex; gap: 12px; align-items: center; margin-bottom: 8px;
  border: 1px solid var(--line); background: var(--bg); border-radius: 9px; padding: 13px 14px; font-size: 15px;
}
.opt .k { width: 18px; flex: none; font-size: 12px; color: var(--muted); font-family: "SF Mono", Menlo, monospace; }
.opt-hover { border-color: var(--steel); }
.opt.right { border-color: var(--good); background: var(--good-soft); }
.opt.wrong { border-color: var(--accent); background: var(--accent-soft); }
.fb { margin-top: 6px; font-size: 14px; }
.fb-ok { color: var(--good); font-weight: 600; }
.fb-no { color: var(--accent); font-weight: 600; }
.q-ctrl { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 14px; }
.q-ctrl.solo { grid-template-columns: 1fr; }

/* 问答 */
.qa-note { background: var(--accent-soft); color: var(--ink); border-radius: 8px; padding: 10px 14px; font-size: 14px; margin-bottom: 4px; }
.qa { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; margin-bottom: 8px; overflow: hidden; }
.qa-sum { display: flex; gap: 10px; align-items: flex-start; padding: 12px 14px; }
.qn { flex: none; font-size: 12px; color: var(--accent); padding-top: 3px; font-family: "SF Mono", Menlo, monospace; }
.qa-t { flex: 1; min-width: 0; }
.qzh { font-weight: 700; font-size: 15px; }
.qen { font-size: 13px; color: var(--muted); }
.qa-arrow { flex: none; color: var(--muted); font-size: 18px; line-height: 1.2; }
.qa-body { padding: 0 14px 14px; }
.qa-sec { border-left: 3px solid var(--line); padding-left: 10px; margin-top: 10px; font-size: 14px; }
.qa-h { font-size: 11px; color: var(--muted); font-weight: 600; letter-spacing: .04em; }
.good-b { border-color: var(--good); }
.good-b .qa-h { color: var(--good); }
.flag-b { border-color: var(--accent); }
.flag-b .qa-h { color: var(--accent); }
