.page { padding: 16px 16px calc(24px + env(safe-area-inset-bottom)); }
.hero { padding: 4px 4px 14px; }
.h1 { font-size: 24px; font-weight: 700; }
.sub { font-size: 13px; color: var(--muted); }
.deck {
  position: relative; overflow: hidden;
  background: var(--panel); border: 1px solid var(--line); border-radius: 14px;
  padding: 16px 18px 14px 22px; margin-bottom: 12px;
}
.deck::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 5px; background: var(--accent); }
.deck-top { display: flex; justify-content: space-between; align-items: center; }
.tag { font-size: 12px; color: var(--accent); background: var(--accent-soft); padding: 1px 8px; border-radius: 4px; }
.ct { font-size: 12px; color: var(--muted); font-family: "SF Mono", Menlo, monospace; }
.title { font-size: 19px; font-weight: 700; margin-top: 8px; }
.en { font-size: 13px; color: var(--steel); }
.desc { font-size: 13px; color: var(--muted); margin: 6px 0 12px; }
.meta { font-size: 12px; color: var(--muted); margin-top: 6px; }
.soon { text-align: center; color: var(--muted); font-size: 12px; margin-top: 20px; }
