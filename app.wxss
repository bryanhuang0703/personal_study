page {
  --bg: #eef1f4; --panel: #ffffff; --ink: #15202b; --muted: #5d6b78; --line: #d5dce3;
  --accent: #e0571f; --accent-soft: #fbe6dc; --steel: #2f5d7c; --steel-soft: #dde8f0;
  --good: #2f8a5b; --good-soft: #dcf0e4;
  background: var(--bg);
  color: var(--ink);
  font-size: 15px;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "HarmonyOS Sans SC", "MiSans", "Microsoft YaHei", sans-serif;
}
@media (prefers-color-scheme: dark) {
  page {
    --bg: #0f151b; --panel: #17212a; --ink: #e6ecf1; --muted: #93a3b1; --line: #2a3743;
    --accent: #ff7a3d; --accent-soft: #3a2418; --steel: #7fb3d6; --steel-soft: #1d3142;
    --good: #5cc48d; --good-soft: #193326;
  }
}

/* 通用组件 */
.bar { height: 4px; background: var(--line); border-radius: 2px; overflow: hidden; }
.bar .fill { height: 100%; background: var(--good); transition: width .3s; }
.chip {
  display: inline-flex; align-items: center; flex: none;
  border: 1px solid var(--line); background: var(--panel);
  padding: 5px 12px; border-radius: 999px; font-size: 13px; color: var(--muted);
}
.chip.on { border-color: var(--steel); background: var(--steel-soft); color: var(--steel); font-weight: 500; }
.btn {
  display: flex; align-items: center; justify-content: center;
  border: 1px solid var(--line); background: var(--panel);
  padding: 12px 6px; border-radius: 8px; font-weight: 500; font-size: 15px;
}
.btn.pri { background: var(--accent); border-color: var(--accent); color: #fff; }
.btn.ok { background: var(--good-soft); border-color: var(--good); color: var(--good); }
.btn.again { background: var(--accent-soft); border-color: var(--accent); color: var(--accent); }
.tap-active { opacity: .7; }
.empty { padding: 40px 16px; text-align: center; color: var(--muted); }
.good { color: var(--good); font-weight: 600; }

/* 底部 tabs */
.tabs {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 10;
  display: flex; gap: 6px; background: var(--panel); border-top: 1px solid var(--line);
  padding: 6px 10px calc(6px + env(safe-area-inset-bottom));
}
.tab { flex: 1; text-align: center; padding: 10px 0; border-radius: 6px; font-size: 15px; font-weight: 500; }
.tab.on { background: var(--accent); color: #fff; }
